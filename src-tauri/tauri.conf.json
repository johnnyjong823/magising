{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "魔唱",
  "mainBinaryName": "MagiSing",
  "version": "0.4.3",
  "identifier": "com.magising.app",
  "build": {
    "frontendDist": "../build/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Johnny",
    "homepage": "https://johnnyx9487.bdcweb.org/",
    "shortDescription": "魔唱 MagiSing：一邊用電腦，一邊跟著字幕唱",
    "longDescription": "播歌時自動找歌詞，在螢幕上顯示 KTV 逐字字幕。",
    "copyright": "© 2026 Johnny",
    "licenseFile": "LICENSE.txt",
    "resources": {
      "LICENSE.txt": "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["TradChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
